{
  "name": "kubeview-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Next-generation Kubernetes desktop IDE and operations platform",
  "license": "BSL-1.1",
  "author": "PorKeat <alexkgm2412@gmail.com>",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:web": "pnpm --filter @kubeview/desktop dev",
    "dev:tauri": "./scripts/dev.sh --tauri",
    "build:engine": "go -C engine build -ldflags=\"-s -w\" -o bin/kubeview-engine ./cmd/kubeview-engine",
    "build:contracts": "pnpm --filter @kubeview/contracts build",
    "build": "pnpm build:contracts && pnpm build:engine && pnpm --filter @kubeview/desktop build",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm --filter @kubeview/desktop test:e2e",
    "test:e2e:ui": "pnpm --filter @kubeview/desktop test:e2e:ui",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
