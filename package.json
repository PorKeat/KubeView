{
  "name": "kubeview-monorepo",
  "private": true,
  "version": "0.3.3",
  "description": "Next-generation Kubernetes desktop IDE and operations platform",
  "license": "Apache-2.0",
  "author": "Seng Porkeat <alexkgm2412@gmail.com>",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:web": "pnpm --filter @kubeview/desktop dev",
    "dev:tauri": "./scripts/dev.sh --tauri",
    "build:engine": "node scripts/build-engine.mjs",
    "build:contracts": "pnpm --filter @kubeview/contracts build",
    "build": "pnpm build:contracts && pnpm build:engine && pnpm --filter @kubeview/desktop build",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "pnpm build:contracts && go -C engine test ./...",
    "test:e2e": "pnpm --filter @kubeview/desktop test:e2e",
    "test:e2e:live": "pnpm --filter @kubeview/desktop test:e2e:live",
    "test:e2e:all": "pnpm --filter @kubeview/desktop test:e2e:all",
    "test:e2e:ui": "pnpm --filter @kubeview/desktop test:e2e:ui",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "prettier": "^3.10.1",
    "typescript": "^5.8.2",
    "lefthook": "^1.11.0"
  }
}
